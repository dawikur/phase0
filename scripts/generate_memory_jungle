import argparse
from pathlib import Path

from scripts.utils.memory_jungle import render_memory_jungle

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--manifest", type=Path, default=Path("manifest.xml"))
    args = parser.parse_args()

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(render_memory_jungle(args.manifest), encoding="utf-8")
