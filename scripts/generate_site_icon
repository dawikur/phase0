#!/usr/bin/env python3
# Copyright (c) 2026 Dawid Kurek <hello@dawikur.dev>

import argparse
import re
import xml.etree.ElementTree as ET
from pathlib import Path

from PIL import Image, ImageDraw

BACKGROUND = (0x55, 0x55, 0x55, 0xFF)
SVG_NAMESPACE = "{http://www.w3.org/2000/svg}"
COLOR_RE = re.compile(r"rgba?\(([^)]+)\)")


def parse_color(value: str) -> tuple[int, int, int, int]:
    match = COLOR_RE.fullmatch(value)
    if match is None:
        raise ValueError(f"Unsupported SVG fill color: {value}")

    channels = [channel.strip() for channel in match.group(1).split(",")]
    red, green, blue = (int(channel) for channel in channels[:3])
    alpha = round(float(channels[3]) * 255) if len(channels) == 4 else 255
    return red, green, blue, alpha


def draw_rectangle(artwork: Image.Image, rectangle: ET.Element) -> Image.Image:
    x = int(float(rectangle.attrib["x"]))
    y = int(float(rectangle.attrib["y"]))
    width = int(float(rectangle.attrib["width"]))
    height = int(float(rectangle.attrib["height"]))
    layer = Image.new("RGBA", artwork.size, (0, 0, 0, 0))
    draw = ImageDraw.Draw(layer)
    draw.rectangle(
        (x, y, x + width - 1, y + height - 1),
        fill=parse_color(rectangle.attrib["fill"]),
    )
    return Image.alpha_composite(artwork, layer)


def render_icon(source: Path, size: int) -> Image.Image:
    root = ET.parse(source).getroot()
    width = int(root.attrib["width"])
    height = int(root.attrib["height"])
    artwork = Image.new("RGBA", (width, height), (0, 0, 0, 0))

    for rectangle in root.findall(f"{SVG_NAMESPACE}rect"):
        artwork = draw_rectangle(artwork, rectangle)

    margin = size // 10
    artwork_scale = min(
        (size - 2 * margin) / artwork.width,
        (size - 2 * margin) / artwork.height,
    )
    artwork = artwork.resize(
        (
            round(artwork.width * artwork_scale),
            round(artwork.height * artwork_scale),
        ),
        Image.Resampling.NEAREST,
    )
    canvas = Image.new("RGBA", (size, size), BACKGROUND)
    position = (
        (size - artwork.width) // 2,
        (size - artwork.height) // 2,
    )
    canvas.alpha_composite(artwork, position)
    return canvas.convert("RGB")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Generate a PNG icon from the project SVG"
    )
    parser.add_argument("--input", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--size", type=int, required=True)
    args = parser.parse_args()

    args.output.parent.mkdir(parents=True, exist_ok=True)
    render_icon(args.input, args.size).save(args.output, format="PNG", optimize=True)


if __name__ == "__main__":
    main()
