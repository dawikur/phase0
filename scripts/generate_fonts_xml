#!/usr/bin/env python3
# Copyright (c) 2026 Dawid Kurek <dawikur@gmail.com>

import textwrap
from typing import Any, Dict, List

import fonts_data
from PIL import Image, ImageDraw

STYLE = fonts_data.STYLE_REGULAR
TYPEFACE = fonts_data.TYPEFACE_DOT


def render_text(
    text: str,
    atlas_image: Image.Image,
    chars: List[Dict[str, Any]],
    GLYPH_W: int,
    GLYPH_H: int,
) -> Image.Image:
    """
    text        : string to render
    atlas_image : 1-bit font atlas
    chars       : list of dicts with glyph metrics (as from your main code)
    GLYPH_W     : fixed glyph width
    GLYPH_H     : fixed glyph height
    """
    # build quick lookup by codepoint
    char_map = {c["id"]: c for c in chars}

    # output image width = len(text) * GLYPH_W
    out_w = len(text) * GLYPH_W
    out_h = GLYPH_H
    out_image = Image.new("1", (out_w, out_h), 0)
    draw = ImageDraw.Draw(out_image)

    x = 0  # pen position

    for ch in text:
        code = ord(ch)
        if code not in char_map:
            # unknown glyph → skip (or treat as space)
            x += GLYPH_W
            continue

        g = char_map[code]

        # crop the glyph from atlas
        glyph_box = (g["x"], g["y"], g["x"] + g["width"], g["y"] + g["height"])
        glyph_bitmap = atlas_image.crop(glyph_box)

        # paste into output at current pen position
        out_image.paste(glyph_bitmap, (x + g["xoffset"], g["yoffset"]))

        # advance pen
        x += g["xadvance"]

    return out_image


def render_glyph(
    draw: ImageDraw, atlas_x: int, atlas_y: int, glyph: fonts_data.Glyph
) -> None:
    for y in range(glyph.height):
        for x in range(glyph.width):
            if glyph.pixel(x, y):
                px = atlas_x + x * STYLE.size
                py = atlas_y + y * STYLE.size

                draw.rectangle(
                    [px, py, px + STYLE.weight - 1, py + STYLE.weight - 1], fill=1
                )


def main() -> None:
    visible_glyphs = [g for g in TYPEFACE.glyphs if g.name not in (" ", "\t")]

    GLYPH_W = visible_glyphs[0].width * STYLE.size
    GLYPH_H = visible_glyphs[0].height * STYLE.size
    COUNT = len(visible_glyphs)

    SPACE_ADVANCE = GLYPH_W

    ATLAS_W = COUNT * GLYPH_W
    ATLAS_H = GLYPH_H

    image = Image.new("1", (ATLAS_W, ATLAS_H), 0)  # 0 = black / transparent
    draw = ImageDraw.Draw(image)

    chars = []

    chars.append(
        {
            "id": ord(" "),
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0,
            "xoffset": 0,
            "yoffset": 0,
            "xadvance": SPACE_ADVANCE + 1,
        }
    )

    atlas_x = 0
    atlas_y = 0

    for glyph in visible_glyphs:
        if glyph.name == " " or glyph.name == "\t":
            continue

        render_glyph(draw, atlas_x, atlas_y, glyph)

        chars.append(
            {
                "id": ord(glyph.name[0]),
                "x": atlas_x,
                "y": atlas_y,
                "width": GLYPH_W,
                "height": GLYPH_H,
                "xoffset": 0,
                "yoffset": 0,
                "xadvance": GLYPH_W + 1,
            }
        )

        atlas_x += GLYPH_W

    # image.save("font.png", optimize=True)
    # image.show()

    print(
        textwrap.dedent(
            f"""\
        info face="MyFixedFont" size={GLYPH_H}
        common lineHeight={GLYPH_H} base={GLYPH_H} scaleW={ATLAS_W} scaleH={ATLAS_H} pages=1
        page id=0 file="font.png"
        chars count={len(chars)}
    """
        )
    )

    for char in chars:
        print(
            f"char id={char['id']} "
            f"x={char['x']} y={char['y']} "
            f"width={char['width']} height={char['height']} "
            f"xoffset={char['xoffset']} yoffset={char['yoffset']} "
            f"xadvance={char['xadvance']} page=0"
        )

    rendered = render_text("Hello, World!", image, chars, GLYPH_W, GLYPH_H)
    rendered.show()


if __name__ == "__main__":
    main()
