#!/usr/bin/env python3
# Copyright (c) 2026 Dawid Kurek <dawikur@gmail.com>

import os
import textwrap
import xml.etree.ElementTree as ET
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple, Union

import fonts_data
from args_parse import Folders, parse_folders
from PIL import Image, ImageDraw


class Atlas:
    img: Image
    draw: ImageDraw

    pos_x: int
    pos_y: int

    def __init__(self, width: int, height: int):
        self.img = Image.new("1", (width, height), 0)
        self.draw = ImageDraw.Draw(self.img)

        self.pos_x = 0
        self.pos_y = 0

    def add(
        self,
        glyph: fonts_data.Glyph,
        style: fonts_data.Style,
        dx: int = 0,
        dy: int = 0,
    ) -> None:
        for y in range(0, glyph.height):
            for x in range(0, glyph.width):
                if glyph.pixel(glyph.xoffset + x, glyph.yoffset + y):
                    pos_x = self.pos_x + x * style.size
                    pos_y = self.pos_y + y * style.size

                    self.draw.rectangle(
                        [
                            dx + pos_x,
                            dy + pos_y,
                            dx + pos_x + style.weight - 1,
                            dy + pos_y + style.weight - 1,
                        ],
                        fill=1,
                    )

    def advance(self, dx: int) -> None:
        self.pos_x += dx


@dataclass
class Glyph:
    id: int
    x: int
    y: int
    width: int
    height: int
    xoffset: int
    yoffset: int
    xadvance: int

    def __str__(self) -> str:
        return (
            f"char id={self.id} "
            f"x={self.x} y={self.y} "
            f"width={self.width} height={self.height} "
            f"xoffset={self.xoffset} yoffset={self.yoffset} "
            f"xadvance={self.xadvance} page=0 chnl=0"
        )


class Fnt:
    name: str
    atlas_w: int
    atlas_h: int
    line_h: int

    glyphs: List[Glyph]

    def __init__(self, name: str, atlas_w: int, atlas_h: int, line_h: int) -> None:
        self.name = name
        self.atlas_w = atlas_w
        self.atlas_h = atlas_h
        self.line_h = line_h

        self.glyphs = []

    def __str__(self) -> str:
        return textwrap.dedent(f"""\
            info face="{self.name}" size={self.line_h}
            common lineHeight={self.line_h} base={self.line_h} scaleW={self.atlas_w} scaleH={self.atlas_h} pages=1
            page id=0 file="{self.name}.png"
            chars count={len(self.glyphs)}
        """) + "\n".join(str(glyph) for glyph in self.glyphs)

    def add(
        self,
        name: str,
        atlas_x: int,
        atlas_y: int,
        width: int,
        height: int,
        xoffset: int,
        yoffset: int,
        xadvance: int,
    ) -> None:
        self.glyphs.append(
            Glyph(
                id=ord(name[0]),
                x=atlas_x,
                y=atlas_y,
                width=width if (width and height) else 0,
                height=height if (width and height) else 0,
                xoffset=xoffset if (width and height) else 0,
                yoffset=yoffset if (width and height) else 0,
                xadvance=xadvance,
            )
        )


def parse_typeface_and_style(
    typefaces: Union[fonts_data.Typeface, List[fonts_data.Typeface]],
    styles: Union[fonts_data.Style, List[fonts_data.Style]],
    name: Optional[str] = None,
    *args: Any,
    required_glyphs: Optional[set[str]] = None,
    **kwargs: Any,
) -> Tuple[str, Image, str, Dict[str, str]]:
    if not isinstance(typefaces, list):
        typefaces = [typefaces]
    if not isinstance(styles, list):
        styles = [styles]

    assert len(typefaces) == len(styles)

    if name is None:
        if 1 == len(typefaces):
            name = (
                name
                or f"{typefaces[0].name} {styles[0].name}".replace(" ", "_").lower()
            )
        else:
            assert False, "Name is required if there isn't exactly one typeface"

    if not typefaces:
        fnt = Fnt(name=name.lower(), atlas_w=0, atlas_h=0, line_h=0)
        atlas = Atlas(width=0, height=0)
        return fnt.name, atlas.img, str(fnt), {}

    glyph_lists = [sorted(tf.glyphs, key=lambda g: g.name) for tf in typefaces]

    glyph_count = len(glyph_lists[0])
    for gl in glyph_lists:
        assert len(gl) == glyph_count

    atlas_w = 0
    atlas_h = 0
    line_h = 0

    # ---- First pass: atlas metrics ----
    for idx in range(glyph_count):
        glyph_names = {glyph_lists[i][idx].name[0] for i in range(len(glyph_lists))}
        assert len(glyph_names) == 1

        glyph_name = list(glyph_names)[0]

        if required_glyphs is None or glyph_name in required_glyphs:
            widths = []
            heights = []
            yadvances = []

            for glyphs, style in zip(glyph_lists, styles):
                glyph = glyphs[idx]

                widths.append(glyph.width * style.size)
                heights.append(glyph.height * style.size)
                yadvances.append(glyph.yadvance * style.size)

            atlas_w += max(widths)
            atlas_h = max(atlas_h, max(heights))
            line_h = max(line_h, max(yadvances))

    fnt = Fnt(
        name=name.lower(),
        atlas_w=atlas_w,
        atlas_h=atlas_h,
        line_h=line_h,
    )

    atlas = Atlas(width=fnt.atlas_w, height=fnt.atlas_h)
    names_comments = {}

    # ---- Second pass: glyph placement ----
    for idx in range(glyph_count):
        glyphs_at_idx = [gl[idx] for gl in glyph_lists]
        glyph_name = glyphs_at_idx[0].name[0]
        glyph_comment = glyphs_at_idx[0].name[1:]

        if glyph_name == "#" and glyph_comment != "":
            glyph_name = chr(ord(" ") + idx)

        if required_glyphs is None or glyph_name in required_glyphs:
            widths = []
            heights = []
            xoffsets = []
            yoffsets = []
            xadvances = []

            for glyph, style in zip(glyphs_at_idx, styles):
                widths.append(glyph.width * style.size)
                heights.append(glyph.height * style.size)
                xoffsets.append(glyph.xoffset * style.size)
                yoffsets.append(glyph.yoffset * style.size)
                xadvances.append(glyph.xadvance * style.size + 1)

            max_width = max(widths)
            max_height = max(heights)

            fnt.add(
                name=glyph_name,
                atlas_x=atlas.pos_x,
                atlas_y=atlas.pos_y,
                width=max_width,
                height=max_height,
                xoffset=min(xoffsets),
                yoffset=min(yoffsets),
                xadvance=max(xadvances),
            )

            # Draw all glyphs centered on top of each other
            for glyph, style, w, h in zip(glyphs_at_idx, styles, widths, heights):
                dx = (max_width - w) / 2
                dy = (max_height - h) / 2
                atlas.add(glyph, style, dx, dy)

            atlas.advance(max_width)

            names_comments[glyph_name] = glyph_comment

    return fnt.name, atlas.img, str(fnt), names_comments


def generate_fonts(folders: Folders, required_glyphs: set[str]) -> None:
    fonts_xml = []
    fonts_mc = []

    def store(font_name: str, atlas: Image, fnt: str) -> None:
        font_png = folders.build("resources", f"{font_name}.png")
        atlas.save(font_png)

        font_fnt = folders.build("resources", f"{font_name}.fnt")
        font_fnt.write_text(fnt)

        FONT_NAME = font_name.upper()

        fonts_xml.append(
            f'\t<font id="{FONT_NAME}" filename="../../{font_fnt}" antialias="false" />'
        )
        fonts_mc.append(
            f"const {FONT_NAME} = Application.loadResource(Rez.Fonts.{FONT_NAME}) as WatchUi.FontResource;"
        )

    # #########################################################################
    # Header

    fonts_xml.append("<fonts>")
    fonts_mc.append(textwrap.dedent("""\
        // Copyright (c) 2026 Dawid Kurek <dawikur@gmail.com>
        // This fie is autogenerated

        import Toybox.Application;
        import Toybox.WatchUi;

        module Font {"""))

    # #########################################################################
    # Digits

    fonts_mc.append(f"\n// Digits\n")
    for digits_meta_data in [
        (fonts_data.TYPEFACE_DIGITS, fonts_data.STYLE_REGULAR_BOLD, "dot_large_bold"),
        (fonts_data.TYPEFACE_DIGITS, fonts_data.STYLE_REGULAR, "dot_large"),
        (fonts_data.TYPEFACE_DIGITS, fonts_data.STYLE_REGULAR_THIN, "dot_large_thin"),
    ]:
        digits_glyphs = set("0123456789:")
        *artefacts, names_comments = parse_typeface_and_style(
            *digits_meta_data, required_glyphs=digits_glyphs
        )
        store(*artefacts)

    # #########################################################################
    # Dots

    fonts_mc.append(f"\n// Dots\n")
    for dot_meta_data in [
        (fonts_data.TYPEFACE_DOT, fonts_data.STYLE_REGULAR),
        (fonts_data.TYPEFACE_DOT, fonts_data.STYLE_REGULAR_THIN),
        (fonts_data.TYPEFACE_DOT, fonts_data.STYLE_SMALL),
        (fonts_data.TYPEFACE_DOT, fonts_data.STYLE_TINY),
    ]:
        *artefacts, names_comments = parse_typeface_and_style(
            *dot_meta_data, required_glyphs=required_glyphs
        )
        store(*artefacts)

    # #########################################################################
    # Icons

    fonts_mc.append(f"\n// Icons\n")
    for icon_meta_data in [
        (fonts_data.TYPEFACE_ICONS, fonts_data.STYLE_SMALL, "icons"),
    ]:
        *artefacts, names_comments = parse_typeface_and_style(*icon_meta_data)
        store(*artefacts)

        fonts_mc.append("")
        for id, comment in names_comments.items():
            ID = id
            NAME = "_".join(comment.split()).upper()

            if ID == "'" or ID == "\\":
                ID = f"\\{ID}"

            fonts_mc.append(f"const ICON_{NAME} = '{ID}';")

    # #########################################################################
    # Styles

    fonts_mc.append(f"\n// Styles\n")
    for style in [
        (fonts_data.STYLE_REGULAR),
        (fonts_data.STYLE_SMALL),
        (fonts_data.STYLE_TINY),
    ]:
        fonts_mc.append(f"const SPACING_{style.name.upper()} = {style.size};")

    # #########################################################################
    # Footer

    fonts_xml.append("</fonts>")
    fonts_mc.append("\n} // module Font")

    # #########################################################################
    # Write

    folders.build("source", "fonts.mc").write_text("\n".join(fonts_mc))
    folders.resources("base", "fonts.xml").write_text("\n".join(fonts_xml))


def get_required_glyphs(folders: Folders) -> set[str]:
    unique_glyphs = {glyph.name for glyph in fonts_data.TYPEFACE_DOT.glyphs}
    all_unique_chars: set[str] = set()
    all_unique_chars.update(" ")  # whitespace
    all_unique_chars.update(":0123456789")  # numbers
    all_unique_chars.update("-CF")  # temperature
    all_unique_chars.update(".kMGTPEZY")  # value suffixes

    for dirpath, _, filenames in os.walk(folders.resources()):
        for filename in filenames:
            if filename == "strings.xml":
                try:
                    unique_chars: set[str] = set()

                    file_path = os.path.join(dirpath, filename)
                    tree = ET.parse(file_path)
                    root = tree.getroot()

                    for elem in root.iter("string"):
                        if elem.text:
                            unique_chars.update(elem.text)
                            all_unique_chars.update(elem.text)

                    diff = unique_chars - unique_glyphs
                    if diff:
                        print(
                            f"WARNING: Missing glyphs for '{dirpath}': {sorted(list(diff))}"
                        )

                except ET.ParseError as e:
                    print(f"XML parse error in {file_path}: {e}")
                except Exception as e:
                    print(f"Error reading {file_path}: {e}")

    return all_unique_chars


def main() -> None:
    folders = parse_folders()

    glyphs = get_required_glyphs(folders)

    generate_fonts(folders, glyphs)


if __name__ == "__main__":
    main()
