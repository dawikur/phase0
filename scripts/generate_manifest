import argparse
from pathlib import Path

from scripts.utils.app_channels import CHANNELS, render_manifest


def main() -> None:
    parser = argparse.ArgumentParser(description="Render a Connect IQ channel manifest")
    parser.add_argument("--channel", choices=CHANNELS, required=True)
    parser.add_argument("--template", type=Path, default=Path("manifest.xml.tmpl"))
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(
        render_manifest(args.template, args.channel), encoding="utf-8"
    )


if __name__ == "__main__":
    main()
