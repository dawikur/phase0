#!/usr/bin/env python3
# Copyright (c) 2026 Dawid Kurek <dawikur@gmail.com>

from typing import Any

from data.settings import (
    Array,
    Boolean,
    Data,
    Group,
    Number,
    Options,
    Select,
    Settings,
)
from scripts.utils.args_parse import parse_folders
from scripts.utils.mc_document import McDocument, McScope
from scripts.utils.xml_document import XmlDocument


def render_data(data: Any) -> str:
    doc = McDocument.create()
    doc.line("import Toybox.Lang;")
    with McScope(doc, "module Data") as _module:
        with McScope(doc, "function get(_id as Lang.Number) as Base or Null") as _get:
            with McScope(doc, "switch (_id)") as _switch:
                for datum in data:
                    datum_name = "".join(
                        part.capitalize() for part in datum.name.split("_")
                    )
                    doc.line(f"case {datum.value}: return new {datum_name}();")

                doc.line()
                doc.line("default: return null;")

    return doc.text()


def render_widgets(extra_data: Any) -> str:
    doc = McDocument.create()
    doc.line("import Toybox.Lang;")
    with McScope(doc, "module Widgets") as _module:
        with McScope(
            doc,
            "function get(_id as Lang.Number, _small as Lang.Boolean) as Base or Null",
        ) as _get:
            with McScope(doc, "switch (_id)") as _switch:
                for datum in extra_data:
                    datum_name = "".join(
                        part.capitalize() for part in datum.name.split("_")
                    )
                    doc.line(f"case {datum.value}: return new {datum_name}(_small);")

                doc.line()
                doc.line("default: return null;")

    return doc.text()


def render_properteis_mc(settings: list[Group | Array]) -> str:
    doc = McDocument.create()
    doc.line("import Toybox.Application;")
    doc.line("import Toybox.Lang;")
    with McScope(doc, "module Properties") as _module:
        for opt in Options:
            doc.line(f"const {opt.name.upper()} = {opt.value};")

        doc.line()

        for group_or_array in settings:
            if isinstance(group_or_array, Group):
                group = group_or_array
                for select in group.selections:
                    doc.line(
                        f"var {group.id.lower()}_{select.id.lower()} "
                        f"as Lang.Number = {select.default};"
                    )

        doc.line()

        with McScope(doc, "function refresh() as Void") as _refresh:
            for group_or_array in settings:
                if isinstance(group_or_array, Group):
                    group = group_or_array
                    for select in group.selections:
                        doc.line(
                            f"{group.id.lower()}_{select.id.lower()} = "
                            f"Application.Properties.getValue("
                            f'"{group.id}{select.id}") as Lang.Number;'
                        )

    return doc.text()


def render_properties_xml(settings: list[Group | Array]) -> str:
    root = XmlDocument.resource("properties")

    for group_or_array in settings:
        if isinstance(group_or_array, Group):
            group = group_or_array
            for select in group.selections:
                property_ = root.subelement(
                    root.root,
                    "property",
                    id=f"{group.id}{select.id}",
                    type="number",
                )
                property_.text = str(select.default)

        if isinstance(group_or_array, Array):
            array = group_or_array
            root.subelement(root.root, "property", id=array.id, type="array")

    return root.render()


def render_group(group: Group) -> XmlDocument:
    group_xml = XmlDocument(
        XmlDocument.element("group", id=group.id, title=f"@Strings.{group.label}")
    )

    for select in group.selections:
        setting = group_xml.subelement(
            group_xml.root,
            "setting",
            propertyKey=f"@Properties.{group.id}{select.id}",
            title=f"@Strings.{select.label}",
        )
        setting_config = group_xml.subelement(
            setting,
            "settingConfig",
            type="list",
            required="true",
        )

        for option, value in select.options.items():
            list_entry = group_xml.subelement(
                setting_config,
                "listEntry",
                value=value,
            )
            list_entry.text = f"@Strings.{option.label}"

    return group_xml


def render_array(array: Array) -> XmlDocument:  # pylint: disable=too-many-locals
    assert 0 < len(array.elements)

    setting_xml = XmlDocument(
        XmlDocument.element(
            "setting",
            propertyKey=f"@Properties.{array.id}",
            title=f"@Strings.{array.label}",
        )
    )

    for select_or_number_or_boolean in array.elements[0]:
        if isinstance(select_or_number_or_boolean, Select):
            select = select_or_number_or_boolean

            setting = setting_xml.subelement(
                setting_xml.root,
                "setting",
                title=f"@Strings.{select.label}",
                type="number",
            )
            setting_config = setting_xml.subelement(
                setting,
                "settingConfig",
                id=select.id,
                type="list",
                required="true",
            )

            for option, value in select.options.items():
                list_entry = XmlDocument.subelement(
                    setting_config,
                    "listEntry",
                    value=value,
                )
                list_entry.text = f"@Strings.{option.label}"
            continue

        if isinstance(select_or_number_or_boolean, Number):
            number = select_or_number_or_boolean

            setting = setting_xml.subelement(
                setting_xml.root,
                "setting",
                title=f"@Strings.{number.label}",
                type="number",
            )
            setting_xml.subelement(
                setting,
                "settingConfig",
                id=number.id,
                type="numeric",
                min="0",
                max="10",
                required="true",
            )
            continue

        if isinstance(select_or_number_or_boolean, Boolean):
            boolean = select_or_number_or_boolean

            setting = setting_xml.subelement(
                setting_xml.root,
                "setting",
                title=f"@Strings.{boolean.label}",
                type="boolean",
            )
            setting_xml.subelement(
                setting,
                "settingConfig",
                id=boolean.id,
                type="boolean",
                required="true",
            )
            continue

        assert False, "Unsupported type"

    defaults = setting_xml.subelement(setting_xml.root, "defaults")

    for element in array.elements:
        entry_xml = setting_xml.subelement(defaults, "entry")
        entry: Any
        for entry in element:
            default_xml = setting_xml.subelement(entry_xml, "default", id=entry.id)
            default_xml.text = str(entry.default).lower()

    return setting_xml


def render_settings(settings: list[Group | Array]) -> str:
    root = XmlDocument.resource("settings")

    for group_or_array in settings:
        if isinstance(group_or_array, Group):
            root.root.append(render_group(group_or_array).root)
            continue

        if isinstance(group_or_array, Array):
            root.root.append(render_array(group_or_array).root)
            continue

        assert False, "Unsupported type"

    return root.render()


def main() -> None:
    folders = parse_folders()

    data = Data(folders.source("data"))
    extra_data, settings = Settings(data)

    folders.source("generated", "data.mc").write_text(render_data(data))
    folders.source("generated", "widgets.mc").write_text(render_widgets(extra_data))
    folders.source("generated", "properties.mc").write_text(
        render_properteis_mc(settings)
    )
    folders.resources("generated", "properties.xml").write_text(
        render_properties_xml(settings)
    )
    folders.resources("generated", "settings.xml").write_text(render_settings(settings))


if __name__ == "__main__":
    main()
