#!/usr/bin/env python3
# Copyright (c) 2026 Dawid Kurek <dawikur@gmail.com>

import textwrap

from args_parse import parse_folders

from data.settings import Data, Options, Settings, Token


def main() -> None:
    folders = parse_folders()

    data = Data(folders.source("data"))
    settings = Settings(data)

    # #########################################################################
    # data

    data_mc = []
    data_mc.append(textwrap.dedent("""\
        // Copyright (c) 2026 Dawid Kurek <dawikur@gmail.com>
        // This file is autogenerated

        import Toybox.Lang;

        module Data {

        function get(_id as Lang.Number) as Base or Null {
        \tswitch (_id) {
    """))

    for datum in data:
        datum_name = "".join(part.capitalize() for part in datum.name.split("_"))  # type: ignore[attr-defined]
        data_mc.append(f"\t\tcase {datum.value}: return new Data.{datum_name}();")  # type: ignore[attr-defined]

    data_mc.append(textwrap.dedent("""\

        \t\tdefault: return null;

        \t}
        }

        } // module Data"""))

    folders.build("source", "data.mc").write_text("\n".join(data_mc))

    # #########################################################################
    # options

    options_mc = []
    options_mc.append(textwrap.dedent("""\
        // Copyright (c) 2026 Dawid Kurek <dawikur@gmail.com>
        // This file is autogenerated

        import Toybox.Lang;

        module Options {\n"""))

    for opt in Options:
        options_mc.append(f"const {opt.name.upper()} = {opt.value};")

    options_mc.append("\n} // module Options")

    folders.build("source", "options.mc").write_text("\n".join(options_mc))

    # #########################################################################
    # properties

    properties_xml = []
    properties_xml.append(
        '<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">'
    )
    for group in settings:
        properties_xml.append("")

        for select in group.selections:
            properties_xml.append(
                f'\t<property id="{group.id}{select.id}" type="number">{select.default}</property>'
            )
    properties_xml.append("\n</properties>")

    folders.resources("settings", "properties.xml").write_text(
        "\n".join(properties_xml)
    )

    # #########################################################################
    # settings

    settings_xml = []
    settings_xml.append(
        '<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">'
    )

    for group in settings:
        settings_xml.append(
            f'\n\t<group id="{group.id}" title="@Strings.{group.label}">'
        )

        for select in group.selections:
            settings_xml.append("")

            settings_xml.append(
                f'\t\t<setting propertyKey="@Properties.{group.id}{select.id}" title="@Strings.{select.label}">'
            )
            settings_xml.append(f'\t\t\t<settingConfig type="list">')

            for option, value in select.options.items():
                settings_xml.append(
                    f'\t\t\t\t<listEntry value="{value}">@Strings.{option.label}</listEntry>'
                )

            settings_xml.append("\t\t\t</settingConfig>")
            settings_xml.append("\t\t</setting>")

        settings_xml.append("\n\t</group>")

    settings_xml.append("\n</settings>")

    folders.resources("settings", "settings.xml").write_text("\n".join(settings_xml))


if __name__ == "__main__":
    main()
