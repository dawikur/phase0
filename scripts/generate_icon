import textwrap
from pathlib import Path
from typing import Tuple

import fonts_data
from args_parse import parse_folders

ICON = fonts_data.ICON
ICON_BLURRED = ICON.blure()


def rgba_to_svg(color: Tuple[int, int, int, int]) -> str:
    r, g, b, a = color
    if a == 255:
        return f"rgb({r},{g},{b})"
    return f"rgba({r},{g},{b},{a / 255})"


def main() -> None:
    folders = parse_folders()

    svg_width = ICON.width * fonts_data.STYLE_REGULAR.size
    svg_height = ICON.height * fonts_data.STYLE_REGULAR.size

    icon_svg = []
    icon_svg.append(
        f'<svg xmlns="http://www.w3.org/2000/svg" '
        f'width="{svg_width}" height="{svg_height}" '
        f'viewBox="0 0 {svg_width} {svg_height}">'
    )

    for icon, style, color in [
        (ICON, fonts_data.STYLE_REGULAR, (0xAA, 0x55, 0x00, 0xFF)),
        (ICON_BLURRED, fonts_data.STYLE_REGULAR_THIN, (0xAA, 0x55, 0x00, 0xFF)),
        (ICON, fonts_data.STYLE_REGULAR_THIN, (0xFF, 0xAA, 0x00, 0xFF)),
    ]:
        fill = rgba_to_svg(color)

        for y in range(icon.height):
            for x in range(icon.width):
                if icon.pixel(x, y):
                    for dy in range(style.weight):
                        for dx in range(style.weight):
                            px = x * style.size + dx
                            py = y * style.size + dy
                            icon_svg.append(
                                f'<rect x="{px}" y="{py}" '
                                f'width="1" height="1" fill="{fill}" />'
                            )

    icon_svg.append("</svg>")

    folders.build("resources", "icon.svg").write_text("\n".join(icon_svg))

    folders.resources("base", "drawables.xml").write_text(textwrap.dedent(f"""\
        <drawables xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
        \t<bitmap id="Icon" filename="../../{folders.build("resources", "icon.svg")}" dithering="none" />
        </drawables>"""))


if __name__ == "__main__":
    main()
